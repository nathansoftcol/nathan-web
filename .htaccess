# Nathan Soft — Apache config para hosting cPanel / LiteSpeed

RewriteEngine On
Options -Indexes
ServerSignature Off

# ---------- HTTPS + dominio canónico ----------
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^(.*)$ https://nathansoft.com.co/$1 [R=301,L]

# ---------- URLs limpias (sin .html) ----------
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

# Redirige las URLs con .html a su versión limpia
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# Quitar index.html del final de la URL
RewriteRule ^(.*)/index$ /$1/ [R=301,L]

# ---------- Cabeceras de seguridad ----------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    Header set X-XSS-Protection "1; mode=block"
    Header set Cross-Origin-Opener-Policy "same-origin"
    Header set Cross-Origin-Resource-Policy "same-origin"
</IfModule>

# ---------- Compresión ----------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml application/xhtml+xml image/svg+xml application/rss+xml application/manifest+json
</IfModule>

# ---------- Cache de assets ----------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"
    ExpiresByType text/html "access plus 1 hour"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/png "access plus 6 months"
    ExpiresByType image/jpeg "access plus 6 months"
    ExpiresByType image/webp "access plus 6 months"
    ExpiresByType image/svg+xml "access plus 6 months"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType application/manifest+json "access plus 1 week"
    ExpiresByType text/xml "access plus 1 day"
</IfModule>

# ---------- MIME types ----------
<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
    AddType image/svg+xml .svg
    AddType image/x-icon .ico
    AddType text/plain .txt
</IfModule>

# ---------- Bloquear acceso a archivos / carpetas sensibles ----------
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
<FilesMatch "(^|/)(README\.md|composer\.json|composer\.lock|package\.json|package-lock\.json)$">
    Require all denied
</FilesMatch>
RewriteRule ^leads(/.*)?$ - [F,L]
RewriteRule ^vendor(/.*)?$ - [F,L]

# ---------- Páginas de error ----------
ErrorDocument 404 /404.html
ErrorDocument 403 /404.html

# ---------- UTF-8 ----------
AddDefaultCharset UTF-8
DirectoryIndex index.html index.php
